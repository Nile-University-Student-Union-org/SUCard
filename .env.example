# Copy to .env.local and fill in. Never commit real secrets.

# Database (compose.dev.yml defaults)
DATABASE_URL=postgres://sucard:sucard@localhost:5432/sucard
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# First super admin, created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=SU Admin

# Microsoft Entra sign-in (Step 3)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
