# Production Environment Configuration Example
# Copy to /srv/sucard/env/.env.production on the VPS and fill in with real values.
# Permissions on server: chmod 600 /srv/sucard/env/.env.production
# NEVER commit the actual .env.production file.

# ------------------------------------------------------------------------------
# DOMAIN & NETWORKING
# ------------------------------------------------------------------------------
# Subdomain for SU Card (used by Caddy reverse proxy)
DOMAIN=card.your-su-domain.example

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Postgres credentials used by the `db` service container
POSTGRES_USER=sucard
POSTGRES_PASSWORD=generate_a_strong_random_password_here_min_32_chars
POSTGRES_DB=sucard

# Database connection URL for the `app` service container
# Format: postgres://<user>:<password>@db:5432/<dbname>
DATABASE_URL=postgres://sucard:generate_a_strong_random_password_here_min_32_chars@db:5432/sucard

# ------------------------------------------------------------------------------
# BETTER AUTH
# ------------------------------------------------------------------------------
# A strong random secret key for session signing and encryption (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=generate_a_long_random_secret_with_openssl_rand_base64_32

# Canonical public base URL of the SU Card application (NO trailing slash)
BETTER_AUTH_URL=https://card.your-su-domain.example

# Comma-separated list of additional trusted origins (leave empty in production)
TRUSTED_ORIGINS=

# ------------------------------------------------------------------------------
# MICROSOFT ENTRA ID (OAuth 2.0 / OpenID Connect)
# ------------------------------------------------------------------------------
# Nile University Microsoft Entra ID Tenant GUID
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Azure App Registration Application (client) GUID
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Azure App Registration Client Secret Value (rotate regularly!)
MICROSOFT_CLIENT_SECRET=your_azure_client_secret_value_here

# ------------------------------------------------------------------------------
# GOOGLE WALLET PASSES (Generic Pass API)
# ------------------------------------------------------------------------------
# Google Wallet Issuer ID from Google Pay & Wallet Console
GOOGLE_WALLET_ISSUER_ID=3388000000022222222

# Service account email with Google Wallet API access
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=sucard-wallet-sa@project-id.iam.gserviceaccount.com

# Path to the mounted service account JSON key file inside the container
# Placed on host at /srv/sucard/secrets/google-wallet.json and mounted read-only
GOOGLE_WALLET_KEY_FILE=/srv/sucard/secrets/google-wallet.json

# Optional HTTPS public base URL for Google Wallet image assets (defaults to BETTER_AUTH_URL)
PUBLIC_BASE_URL=https://card.your-su-domain.example

# ------------------------------------------------------------------------------
# INITIAL SUPER ADMIN SEED (First run only)
# ------------------------------------------------------------------------------
# Used when running `docker compose -f compose.prod.yml run --rm app node scripts/seed.mjs`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=generate_a_strong_temporary_admin_password_min_8_chars
SEED_ADMIN_NAME=SU Super Admin

# ------------------------------------------------------------------------------
# EMAIL (Power Automate polls the RSS outbox feed — see docs/EMAIL-SETUP.md)
# ------------------------------------------------------------------------------
# Long random key (openssl rand -hex 32); the same value goes into the Power Automate flow
MAILER_FEED_KEY=generate_with_openssl_rand_hex_32
