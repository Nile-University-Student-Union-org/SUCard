# Caddy configuration for SU Card (card.<su-domain>)
# Reverse proxy to Next.js standalone container with automatic HTTPS

{$DOMAIN:card.example.com} {
    # Request body limit (10MB for QR batch ZIPs and vendor assets)
    request_body {
        max_size 10MB
    }

    # Compression (modern zstd and standard gzip)
    encode zstd gzip

    # Security headers
    header {
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Clickjacking protection
        X-Frame-Options "SAMEORIGIN"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # HSTS (1 year)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Permissions policy: allow camera for QR scanning on self
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        # Remove server identity
        -Server
    }

    # Reverse proxy to Next.js app container
    reverse_proxy app:3000 {
        # Preserves client IP headers when behind Cloudflare
        trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

        # Header timeouts and buffers
        transport http {
            response_header_timeout 60s
            read_timeout 60s
            write_timeout 60s
        }
    }

    # Log access in JSON format
    log {
        output stdout
        format json
    }
}

# Optional: If using Cloudflare Origin CA Certificate instead of Let's Encrypt:
# 1. Save certificate to /srv/sucard/secrets/origin.crt and key to /srv/sucard/secrets/origin.key
# 2. Mount /srv/sucard/secrets into caddy container
# 3. Replace the automatic HTTPS block with:
# tls /srv/sucard/secrets/origin.crt /srv/sucard/secrets/origin.key
